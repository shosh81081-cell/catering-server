# העתיקי קובץ זה לקובץ בשם .env ומלאי את הערכים

# כתובת החיבור ל-MongoDB Atlas (מתקבלת באתר Atlas בכפתור Connect)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/catering

# מחרוזת סודית לחתימת הטוקנים - כל טקסט ארוך ואקראי
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000

# כתובת צד הלקוח (בפיתוח: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# פרטי המנהל שייווצר בהרצת npm run seed
ADMIN_EMAIL=admin@catering.com
ADMIN_PASSWORD=admin123
